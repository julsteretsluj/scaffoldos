datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  VIDEO
  TEXT_MARKDOWN
  QUIZ
  ASSIGNMENT
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  LEADERSHIP
  GUARDIAN
  TUTOR
  CLINICIAN
}

enum EnergyLevel {
  GREEN
  YELLOW
  RED
}

enum EnergyRating {
  LOW
  MEDIUM
  HIGH
}

enum SubmissionFormat {
  FILE
  AUDIO
  VIDEO
  LINK
  TEXT
}

enum WorkStatus {
  TO_DO
  IN_PROGRESS
  NEED_SUPPORT
  COMPLETED
  PAUSED
  NEEDS_ATTENTION
  HELP_REQUESTED
  SUBMITTED
}

enum ProjectTrack {
  COLLABORATIVE
  INDEPENDENT
}

enum DeadlineKind {
  HARD
  SOFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  REMOTE
}

enum SafetyPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ConversationKind {
  DIRECT
  CLASSROOM
  SCHOOL
}

enum StreamPostKind {
  ANNOUNCEMENT
  MATERIAL
  DISCUSSION
  ASSIGNMENT_LINK
}

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  description      String?      @db.Text
  coverImage       String?
  status           CourseStatus @default(DRAFT)
  gradeBand        String?
  gradeLevel       String?
  subjectCode      String?
  syllabusUrl      String?
  udlFrameworkData String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  modules          Module[]
  assignments      Assignment[]
  enrollments      Enrollment[]
  attendance       AttendanceRecord[]
  classroomChat    Conversation?
  streamPosts      ClassStreamPost[]
  studyNotes       StudyNote[]
  announcements    Announcement[]
  messagesScoped   Message[]

  @@index([slug])
  @@index([status])
  @@index([gradeBand])
  @@index([subjectCode])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id            String      @id @default(cuid())
  moduleId      String
  title         String
  type          ContentType @default(TEXT_MARKDOWN)
  content       String?     @db.Text
  videoUrl      String?
  order         Int
  isFreePreview Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Person {
  id                 String   @id @default(cuid())
  name               String
  preferredName      String?
  email              String?  @unique
  phone              String?
  role               UserRole @default(STUDENT)
  schedulePreference String?
  contactDetails     String?  @db.Text
  address            String?  @db.Text
  emergencyContact   String?
  enrollmentNotes    String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accommodation      AccommodationProfile?
  safetyPlans        SafetyPlan[]
  checkIns           EnergyCheckIn[]
  attendance         AttendanceRecord[]
  submissions        Submission[]
  helpRequests       HelpRequest[]
  careNotes          CareNote[]            @relation("CareSubject")
  authoredNotes      CareNote[]            @relation("CareAuthor")
  projectChoices     ProjectTrackChoice[]
  guardiansOf        GuardianLink[]        @relation("Guardian")
  childrenOf         GuardianLink[]        @relation("Ward")
  enrollments        Enrollment[]
  contactsOwned      ContactRecord[]       @relation("ContactOwner")
  contactsAbout      ContactRecord[]       @relation("ContactSubject")
  newsPosts          NewsPost[]
  announcements      Announcement[]
  streamPosts        ClassStreamPost[]
  streamComments     StreamComment[]
  studyNotes         StudyNote[]
  messagesSent       Message[]             @relation("MessageSender")
  conversationParts  ConversationParticipant[]

  @@index([role])
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  personId  String
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([courseId, personId])
  @@index([personId])
}

model ContactRecord {
  id          String   @id @default(cuid())
  ownerId     String?
  subjectId   String
  label       String
  value       String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   Person? @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  subject Person  @relation("ContactSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
}

model GuardianLink {
  id         String @id @default(cuid())
  guardianId String
  studentId  String

  guardian Person @relation("Guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student  Person @relation("Ward", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
}

model AccommodationProfile {
  id                     String   @id @default(cuid())
  studentId              String   @unique
  sensoryNeeds           String?  @db.Text
  approvedAccommodations String?  @db.Text
  communicationStyle     String?  @db.Text
  psychologistNotes      String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  student Person @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model SafetyPlan {
  id               String           @id @default(cuid())
  personId         String
  title            String
  triggers         String?          @db.Text
  warningSigns     String?          @db.Text
  copingStrategies String?          @db.Text
  supportContacts  String?          @db.Text
  crisisSteps      String?          @db.Text
  status           SafetyPlanStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([status])
}

model Assignment {
  id                String       @id @default(cuid())
  courseId          String
  title             String
  brief             String?      @db.Text
  energyRating      EnergyRating @default(MEDIUM)
  estimatedMinutes  Int?
  deadlineKind      DeadlineKind @default(SOFT)
  hardDeadline      DateTime?
  softDeadline      DateTime?
  rubricJson        String?      @db.Text
  resourceCardsJson String?      @db.Text
  choicePrompt      String?      @db.Text
  roleCardsJson     String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  milestones   MicroMilestone[]
  submissions  Submission[]
  trackChoices ProjectTrackChoice[]

  @@index([courseId])
  @@index([hardDeadline])
}

model MicroMilestone {
  id            String    @id @default(cuid())
  assignmentId  String
  stepNumber    Int
  title         String
  suggestedDate DateTime?
  timeEstimate  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  progress   MilestoneProgress[]

  @@index([assignmentId])
}

model MilestoneProgress {
  id          String   @id @default(cuid())
  milestoneId String
  studentId   String
  done        Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  milestone MicroMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, studentId])
}

model Submission {
  id               String           @id @default(cuid())
  assignmentId     String
  studentId        String
  submissionFormat SubmissionFormat @default(TEXT)
  content          String?          @db.Text
  fileUrl          String?
  status           WorkStatus       @default(SUBMITTED)
  boardStatus      WorkStatus       @default(TO_DO)
  reflection       String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Person     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId])
  @@index([boardStatus])
}

model ProjectTrackChoice {
  id           String       @id @default(cuid())
  assignmentId String
  studentId    String
  track        ProjectTrack @default(INDEPENDENT)
  roleCard     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Person     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model EnergyCheckIn {
  id        String      @id @default(cuid())
  studentId String
  level     EnergyLevel
  note      String?
  createdAt DateTime    @default(now())

  student Person @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  courseId  String?
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  present   Boolean          @default(true)
  note      String?
  createdAt DateTime         @default(now())

  student Person  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId, date])
  @@index([date])
  @@index([courseId])
}

model HelpRequest {
  id        String     @id @default(cuid())
  studentId String
  kind      String     @default("task_breakdown")
  message   String     @db.Text
  status    WorkStatus @default(HELP_REQUESTED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  student Person @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model CareNote {
  id             String   @id @default(cuid())
  studentId      String
  authorId       String?
  note           String   @db.Text
  isConfidential Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Person  @relation("CareSubject", fields: [studentId], references: [id], onDelete: Cascade)
  author  Person? @relation("CareAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([studentId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  audience  String   @default("school")
  courseId  String?
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author Person? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([createdAt])
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author Person? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

model Conversation {
  id        String           @id @default(cuid())
  kind      ConversationKind @default(DIRECT)
  title     String?
  courseId  String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  course       Course?                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  personId       String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([conversationId, personId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String?
  courseId       String?
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender       Person        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([courseId, createdAt])
}

model ClassStreamPost {
  id        String         @id @default(cuid())
  courseId  String
  authorId  String?
  kind      StreamPostKind @default(DISCUSSION)
  title     String?
  body      String         @db.Text
  materialUrl String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author   Person?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments StreamComment[]

  @@index([courseId, createdAt])
}

model StreamComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  post   ClassStreamPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Person?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId])
}

model StudyNote {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  subjectTag  String?
  courseId    String?
  uploaderId  String?
  fileName    String
  filePath    String
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  uploader Person? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([subjectTag])
  @@index([courseId])
  @@index([createdAt])
}

model StaffCertification {
  id          String    @id @default(cuid())
  personId    String?
  staffName   String
  topic       String
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([staffName])
}
